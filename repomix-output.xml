    box-shadow: 0 6px 15px rgba(56, 189, 248, 0.4);
    border-color: var(--accent-primary);
}

@keyframes popIn {
    0% {
        transform: scale(0);
        opacity: 0;
    }

    80% {
        transform: scale(1.1);
        opacity: 1;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }
}

#stamps-container {
    max-height: 120px;
    overflow-y: auto;
    padding-right: 5px;
}

#activity-list {
