}

.travel-stats {
    display: flex;
    gap: 40px;
    margin-top: auto;
}

.label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    display: block;
    margin-bottom: 8px;
}

.stat-value {
